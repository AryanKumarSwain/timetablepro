datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model SaaSPlan {
  id           String   @id @default(uuid())
  name         String
  teacherMin   Int
  teacherMax   Int
  priceMonthly Decimal  @db.Decimal(10, 2)
  schools      School[]
  trialSchools School[] @relation("SchoolTrialPlan")
  originalSchools School[] @relation("SchoolOriginalPlan")
}

model School {
  id                      String                  @id @default(uuid())
  name                    String
  type                    String?
  city                    String?
  country                 String?
  studentsRange           String?
  facultyRange            String?
  licenseStatus           LicenseStatus           @default(ACTIVE)
  planId                  String?
  plan                    SaaSPlan?                @relation(fields: [planId], references: [id])
  trialEndsAt             DateTime?
  trialPlanId             String?
  trialPlan               SaaSPlan?                @relation("SchoolTrialPlan", fields: [trialPlanId], references: [id])
  trialStatus             TrialStatus              @default(NONE)
  hasNotifiedTrialEnding  Boolean                 @default(false)
  hasUsedTrial            Boolean                 @default(false)
  originalPlanId          String?
  originalPlan            SaaSPlan?                @relation("SchoolOriginalPlan", fields: [originalPlanId], references: [id])
  createdAt               DateTime                @default(now())
  users                   User[]
  teachers                Teacher[]
  classes                 ClassRoom[]
  subjects                Subject[]
  periods                 Period[]
  weeklySlots             WeeklyTimetableSlot[]
  attendance              TeacherAttendance[]
  replacements            ReplacementAssignment[]
  dailyReports            DailyReport[]
  timetables              Timetable[]
  timetableSlots          TimetableSlot[]
  homework                Homework[]
  leaveRequests           SchoolLeaveRequest[]
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  TRAIL_EXPIRED
}

enum TrialStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String?
  role            UserRole
  schoolId        String?
  school          School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name            String?
  phone           String?
  countryCode     String?
  onboardingDone  Boolean  @default(false)
  teacher         Teacher?
  tokens          VerificationToken[]
  createdAt       DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum VerificationTokenType {
  PASSWORD_RESET
}
enum NotificationType {
  INFO
  ALERT
  SYSTEM
}

enum NotificationScope {
  ALL_ADMINS       // Generated by Super-Admin targets
  SCHOOL_TEACHERS  // Generated by Admin to school targets
}

model Notification {
  id          String            @id @default(uuid())
  title       String
  message     String            @db.Text
  type        NotificationType  @default(INFO)
  scope       NotificationScope
  schoolId    String?           // Nullable for general Super-Admin global broadcasts
  senderId    String            // User profile triggering allocation
  createdAt   DateTime          @default(now())
  
  // Implicit tracking relation array block mapping read receipts
  reads       NotificationRead[]

  @@index([schoolId])
  @@index([scope])
}

model EmailVerification {
  id          String   @id @default(uuid())
  email       String   @unique
  fullName    String
  phone       String
  countryCode String
  password    String
  otp         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  userId         String       // Destination receiver footprint
  readAt         DateTime     @default(now())
  
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}
model VerificationToken {
  id         String                     @id @default(uuid())
  userId     String
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  type       VerificationTokenType      @default(PASSWORD_RESET)
  expiresAt  DateTime
  createdAt  DateTime                   @default(now())

  @@unique([token])
  @@index([userId])
}

model Teacher {
  id                   String                  @id @default(uuid())
  schoolId             String?
  school               School?                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId               String?                 @unique
  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                 String
  email                String
  phone                String
  qualifications       Json                    @default("[]")
  subjects             Json                    @default("[]")
  active               Boolean                 @default(true)
  joinDate             String
  maxPeriodsPerWeek    Int                     @default(24)
  subjectSpecialtyId   String?
  leaveRequestStatus   LeaveRequestStatus      @default(NONE)
  weeklySlots          WeeklyTimetableSlot[]
  timetableSlots       TimetableSlot[]
  dailyReports         DailyReport[]
  attendanceRecords    TeacherAttendance[]
  absentCoverRequests  ReplacementAssignment[] @relation("OriginalTeacher")
  fulfilledCoverDuties ReplacementAssignment[] @relation("ReplacementTeacher")
  homework             Homework[]
  leaveRequests        SchoolLeaveRequest[]

  @@index([schoolId])
}

model Subject {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  code           String
  weeklySlots    WeeklyTimetableSlot[]
  reportEntries  ReportEntry[]
  timetableSlots TimetableSlot[]

  @@index([schoolId])
}

model ClassRoom {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  grade          String
  section        String
  roomNumber     String
  weeklySlots    WeeklyTimetableSlot[]
  reportEntries  ReportEntry[]
  timetableSlots TimetableSlot[]
  homework       Homework[]

  @@index([schoolId])
}

model Period {
  id                     String                  @id @default(uuid())
  schoolId               String
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableId            String?                 
  timetable              Timetable?              @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  periodNumber           Int
  startTime              String
  endTime                String
  isBreak                Boolean                 @default(false) 
  label                  String?                 
  weeklySlots            WeeklyTimetableSlot[]
  timetableSlots         TimetableSlot[]
  replacementAssignments ReplacementAssignment[]

  @@index([schoolId])
  @@index([timetableId])
}

model WeeklyTimetableSlot {
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  periodId  String
  period    Period    @relation(fields: [periodId], references: [id])
  classId   String
  class     ClassRoom @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([dayOfWeek, periodId, classId])
}

model TeacherAttendance {
  id        String           @id @default(uuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id])
  date      String
  status    AttendanceStatus

  @@unique([teacherId, date])
  @@index([schoolId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  FIRST_HALF
  SECOND_HALF
}

model ReplacementAssignment {
  id                   String           @id @default(uuid())
  schoolId             String
  school               School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date                 String
  periodId             String
  period               Period           @relation(fields: [periodId], references: [id])
  classId              String
  originalTeacherId    String
  originalTeacher      Teacher          @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  replacementTeacherId String
  replacementTeacher   Teacher          @relation("ReplacementTeacher", fields: [replacementTeacherId], references: [id])
  reason               LeaveReason      @default(CASUAL_LEAVE)
  status               AssignmentStatus @default(PENDING)
  slotId               String?
  slot                 TimetableSlot?    @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([date, periodId, classId])
}

enum LeaveReason {
  CASUAL_LEAVE
  MEDICAL_LEAVE
  OTHER_DUTY
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
}

model TrialRequest {
  id              String        @id @default(uuid())
  schoolId        String
  schoolName      String
  contactName     String
  phone           String
  expectedFaculty Int
  planId          String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model DailyReport {
  id          String            @id @default(cuid())
  teacherId   String
  teacher     Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reportDate  DateTime
  status      DailyReportStatus @default(DRAFT)
  submittedAt DateTime?
  csvFileUrl  String?
  pdfFileUrl  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  entries     ReportEntry[]

  @@unique([teacherId, reportDate])
  @@index([schoolId])
  @@index([teacherId])
  @@index([reportDate])
  @@index([status])
}

model ReportEntry {
  id          String      @id @default(cuid())
  reportId    String
  report      DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  classId     String
  class       ClassRoom   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  description String      @db.Text
  isCompleted Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([reportId])
  @@index([classId])
  @@index([subjectId])
}

model Timetable {
  id             String          @id @default(cuid())
  name           String
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status         TimetableStatus @default(DRAFT)
  baseStartTime  String          @default("08:00")
  periodDuration Int             @default(45)
  workingDays    Json            
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  slots          TimetableSlot[]
  periods        Period[]        

  @@index([schoolId])
}

model TimetableSlot {
  id          String    @id @default(cuid())
  timetableId String
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  periodId    String
  period      Period    @relation(fields: [periodId], references: [id])
  classId     String
  class       ClassRoom @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  replacements ReplacementAssignment[]

  @@unique([timetableId, dayOfWeek, periodId, classId])
  @@index([timetableId])
  @@index([schoolId])
}

enum HomeworkStatus {
  DRAFT
  SENT_TO_ADMIN
}

model Homework {
  id          String         @id @default(uuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId     String
  class       ClassRoom      @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String         @db.Text
  status      HomeworkStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([status])
}

model SchoolLeaveRequest {
  id          String            @id @default(uuid())
  teacherId   String
  teacher     Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status      LeaveRequestStatus @default(PENDING)
  requestedAt DateTime          @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reason      String?           @db.Text

  @@index([schoolId])
  @@index([teacherId])
  @@index([status])
}