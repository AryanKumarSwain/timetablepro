# Recommended when password contains @ or other URL-special characters:
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=school_timetable

# Or URL-encode special chars in password (@ → %40):
# DATABASE_URL="mysql://root:pass%40word@localhost:3306/school_timetable"

# iron-session secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-character-random-string"

# Public app URL (used for secure cookies in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional — enables "Continue with Google" on signup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000

# SMTP (teacher credential emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@school.com
