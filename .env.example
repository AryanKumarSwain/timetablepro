# Recommended when password contains @ or other URL-special characters:
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=school_timetable

# Or URL-encode special chars in password (@ → %40):
# DATABASE_URL="mysql://root:pass%40word@localhost:3306/school_timetable"

# iron-session secret — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-at-least-32-character-random-string"

# Public app URL (used for secure cookies in production)
NEXT_PUBLIC_APP_URL="https://timetablepro.webncode.in"

# Google OAuth (optional — enables "Continue with Google" on signup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://timetablepro.webncode.in


# SMTP (teacher credential emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@school.com

# Admin account credentials (used in initial database seed)
SUPERADMIN_EMAIL=super@platform.edu
SUPERADMIN_PASSWORD=a@123
SCHOOLADMIN_EMAIL=a@123
SCHOOLADMIN_PASSWORD=a@123

# WhatsApp Cloud API (credentials notification)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME="teacher_credentials"
WHATSAPP_TEMPLATE_LANG="en_US"

