datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model SaaSPlan {
  id           String   @id @default(uuid())
  name         String
  teacherMin   Int
  teacherMax   Int
  priceMonthly Decimal  @db.Decimal(10, 2)
  schools      School[]
}

model School {
  id             String                  @id @default(uuid())
  name           String
  licenseStatus  LicenseStatus           @default(ACTIVE)
  planId         String
  plan           SaaSPlan                @relation(fields: [planId], references: [id])
  createdAt      DateTime                @default(now())
  users          User[]
  teachers       Teacher[]
  classes        ClassRoom[]
  subjects       Subject[]
  periods        Period[]
  weeklySlots    WeeklyTimetableSlot[]
  attendance     TeacherAttendance[]
  replacements   ReplacementAssignment[]
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  TRAIL_EXPIRED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

model Teacher {
  id                    String                  @id @default(uuid())
  schoolId              String
  school                School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                  String
  email                 String
  phone                 String
  maxPeriodsPerWeek     Int                     @default(24)
  subjectSpecialtyId    String
  weeklySlots           WeeklyTimetableSlot[]
  attendanceRecords     TeacherAttendance[]
  absentCoverRequests   ReplacementAssignment[] @relation("OriginalTeacher")
  fulfilledCoverDuties  ReplacementAssignment[] @relation("ReplacementTeacher")

  @@index([schoolId])
}

model Subject {
  id          String                @id @default(uuid())
  schoolId    String
  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String
  weeklySlots WeeklyTimetableSlot[]

  @@index([schoolId])
}

model ClassRoom {
  id          String                @id @default(uuid())
  schoolId    String
  school      School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  grade       String
  section     String
  roomNumber  String
  weeklySlots WeeklyTimetableSlot[]

  @@index([schoolId])
}

model Period {
  id                     String                  @id @default(uuid())
  schoolId               String
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  periodNumber           Int
  startTime              String
  endTime                String
  weeklySlots            WeeklyTimetableSlot[]
  replacementAssignments ReplacementAssignment[]

  @@index([schoolId])
}

model WeeklyTimetableSlot {
  id        String    @id @default(uuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  periodId  String
  period    Period    @relation(fields: [periodId], references: [id])
  classId   String
  class     ClassRoom @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([dayOfWeek, periodId, classId])
}

model TeacherAttendance {
  id        String           @id @default(uuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id])
  date      String
  status    AttendanceStatus

  @@unique([teacherId, date])
  @@index([schoolId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

model ReplacementAssignment {
  id                   String           @id @default(uuid())
  schoolId             String
  school               School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date                 String
  periodId             String
  period               Period           @relation(fields: [periodId], references: [id])
  classId              String
  originalTeacherId    String
  originalTeacher      Teacher          @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  replacementTeacherId String
  replacementTeacher   Teacher          @relation("ReplacementTeacher", fields: [replacementTeacherId], references: [id])
  reason               LeaveReason      @default(CASUAL_LEAVE)
  status               AssignmentStatus @default(PENDING)

  @@index([schoolId])
  @@index([date, periodId, classId])
}

enum LeaveReason {
  CASUAL_LEAVE
  MEDICAL_LEAVE
  OTHER_DUTY
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
}
